generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model contracts {
  contract_address                  String  @id
  event_id                          String?
  contract_type                     String?
  events_contracts_event_idToevents events? @relation("contracts_event_idToevents", fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model events {
  id                                   String                   @id @default(uuid())
  event_type                           String?
  event_name                           String?
  user_id                              String?
  event_category                       String?
  event_start_time                     DateTime?
  event_timezone                       String?
  event_location                       String?
  description                          String?
  event_end_time                       DateTime?
  cost                                 Decimal?
  total_number_tickets                 Int?
  created_at                           DateTime                 @default(now())
  symbol                               String?
  collections                          collections[]
  contracts_contracts_event_idToevents contracts[]              @relation("contracts_event_idToevents")
  event_collections                    event_collections[]
  event_images                         event_images[]
  users                                users?                   @relation(fields: [user_id], references: [id])
  latest_rejecters_queue               latest_rejecters_queue[]
  proposals                            proposals[]
  requests                             requests[]
  stakeholders                         stakeholders[]
  ticket_transaction                   ticket_transaction[]
  tickets                              tickets[]
}

model proposals {
  id                     String                   @id @default(uuid())
  event_id               String?
  user_id                String?
  content                String
  created_at             DateTime                 @default(now())
  previous_proposal_id   String?
  latest_rejecters_queue latest_rejecters_queue[]
  proposal_images        proposal_images[]
  events                 events?                  @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                  users?                   @relation(fields: [user_id], references: [id])
  proposals              proposals?               @relation("proposalsToproposals", fields: [previous_proposal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_proposals        proposals[]              @relation("proposalsToproposals")
  requests               requests[]
  stakeholders           stakeholders[]
  votes                  votes[]
}

model requests {
  id            String     @id @default(uuid())
  event_id      String?
  status        String     @default("Pending")
  created_at    DateTime   @default(now())
  email_address String?
  token         String     @unique
  proposal_id   String?
  proposals     proposals? @relation(fields: [proposal_id], references: [id], onDelete: Cascade)
  events        events?    @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model stakeholders {
  stakeholder_id     String               @id @default(uuid())
  user_id            String?
  event_id           String?
  stake              Int?
  wallet_address     String?
  proposal_id        String?
  fund_distributions fund_distributions[]
  proposals          proposals?           @relation(fields: [proposal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events             events?              @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users              users?               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_wallets       user_wallets?        @relation(fields: [wallet_address], references: [wallet_address], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  id                                                                          String                    @id @default(uuid())
  email                                                                       String                    @unique
  username                                                                    String?                   @unique
  password                                                                    String
  bio                                                                         String?
  email_verified                                                              Boolean?                  @default(false)
  type                                                                        String?
  airdrops                                                                    airdrops[]
  email_verification                                                          email_verification[]
  events                                                                      events[]
  exhibitor_account_users_exhibitor_account_users_exhibitor_account_idTousers exhibitor_account_users[] @relation("exhibitor_account_users_exhibitor_account_idTousers")
  exhibitor_account_users_exhibitor_account_users_user_idTousers              exhibitor_account_users[] @relation("exhibitor_account_users_user_idTousers")
  latest_rejecters_queue                                                      latest_rejecters_queue[]
  password_reset_tokens                                                       password_reset_tokens[]
  proposals                                                                   proposals[]
  social_media_links                                                          social_media_links[]
  stakeholders                                                                stakeholders[]
  ticket_transaction                                                          ticket_transaction[]
  tickets                                                                     tickets[]
  user_images                                                                 user_images[]
  user_sessions                                                               user_sessions[]
  user_wallets                                                                user_wallets[]
  user_types                                                                  user_types?               @relation(fields: [type], references: [type])
  votes                                                                       votes[]
}

model votes {
  id          String     @id @default(uuid())
  proposal_id String?
  user_id     String?
  decision    Boolean
  created_at  DateTime   @default(now())
  proposals   proposals? @relation(fields: [proposal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       users?     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model email_verification {
  id         String   @id @default(uuid())
  user_id    String?
  token      String   @unique
  expires    DateTime
  created_at DateTime
  users      users?   @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model event_images {
  id            String   @id @default(uuid())
  url           String
  event_id      String?
  image_type    String?
  gallery_index Int?
  events        events?  @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model exhibitor_account_users {
  id                                                        String  @id @default(uuid())
  exhibitor_account_id                                      String?
  user_id                                                   String?
  role                                                      String
  users_exhibitor_account_users_exhibitor_account_idTousers users?  @relation("exhibitor_account_users_exhibitor_account_idTousers", fields: [exhibitor_account_id], references: [id], onDelete: Cascade)
  users_exhibitor_account_users_user_idTousers              users?  @relation("exhibitor_account_users_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([exhibitor_account_id, user_id])
}

model fund_distributions {
  id                       String        @id
  stakeholder_id           String?
  amount                   Decimal
  transaction_time         DateTime      @default(now())
  receiving_wallet_address String?
  stakeholders             stakeholders? @relation(fields: [stakeholder_id], references: [stakeholder_id], onDelete: NoAction, onUpdate: NoAction)
}

model latest_rejecters_queue {
  id          String     @id @default(uuid())
  event_id    String?
  proposal_id String?
  user_id     String?
  created_at  DateTime   @default(now())
  events      events?    @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  proposals   proposals? @relation(fields: [proposal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       users?     @relation(fields: [user_id], references: [id])
}

model social_media_links {
  id            String  @id @default(uuid())
  user_id       String?
  linkedin_url  String?
  facebook_url  String?
  twitter_url   String?
  instagram_url String?
  users         users?  @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model ticket_transaction {
  id               String   @id
  event_id         String?
  price            Decimal
  transaction_time DateTime @default(now())
  user_id          String
  wallet_address   String?
  transaction_id   String?
  users            users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  events           events?  @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model tickets {
  event_id       String?
  wallet_address String?
  purchased_at   DateTime? @default(now())
  validity       Int?
  id             Int       @id @default(autoincrement())
  user_id        String
  events         events?   @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model user_images {
  id            String  @id @default(uuid())
  url           String
  user_id       String?
  image_type    String?
  gallery_index Int?
  users         users?  @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model user_sessions {
  session_id    String   @id @default(uuid())
  user_id       String?
  expires       DateTime
  session_token String
  access_token  String
  creation_time DateTime
  update_time   DateTime
  users         users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model user_types {
  id          Int     @id
  type        String  @unique
  description String?
  users       users[]
}

model user_wallets {
  id             String         @id @default(uuid())
  user_id        String
  wallet_address String         @unique
  index          Int?
  stakeholders   stakeholders[]
  users          users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model artifacts {
  name          String?
  image_url     String?
  content       String?
  collection_id String?
  id            String       @id @default(uuid())
  index         Int?
  base_uri      String?
  collections   collections? @relation(fields: [collection_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model collections {
  id                String              @id @default(uuid())
  name              String?
  baseURI           String?
  event_id          String?
  artifacts         artifacts[]
  events            events?             @relation(fields: [event_id], references: [id], onUpdate: NoAction)
  event_collections event_collections[]
}

model event_collections {
  event_id      String
  collection_id String
  collections   collections @relation(fields: [collection_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events        events      @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([event_id, collection_id])
}

model proposal_images {
  id            String    @id @default(uuid())
  proposal_id   String
  url           String
  image_type    String?
  gallery_index Int?
  proposals     proposals @relation(fields: [proposal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model password_reset_tokens {
  id         String    @id @default(uuid())
  user_id    String
  created_at DateTime? @default(now())
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model airdrops {
  id             Int       @id @default(autoincrement())
  user_id        String?
  wallet_address String?
  claimed        Boolean?  @default(false)
  claimed_at     DateTime?
  users          users?    @relation(fields: [user_id], references: [id])
}
