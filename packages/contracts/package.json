{
  "name": "@rev-share/contracts",
  "version": "0.0.1",
  "description": "",
  "scripts": {
    "postinstall": "chmod +x sync-abis.js",
    "test": "REPORT_GAS=true hardhat test",
    "test:coverage": "hardhat coverage --solcoverjs ./.solcover.js --temp build/contracts --testfiles \"./test/*.ts\"",
    "build": "hardhat compile && node sync-abis.js",
    "deploy:dev": "hardhat run --network sepolia scripts/deploy.ts",
    "configure:dev": "hardhat run --network optimism scripts/configure.ts",
    "deploy:prod": "hardhat run --network optimism scripts/deploy.ts",
    "configure:prod": "hardhat run --network optimism scripts/configure.ts",
    "mock:dev": "hardhat run --network scripts/mock.ts",
    "sync:abis": "node sync-abis.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@openzeppelin/contracts-upgradeable": "^5.1.0",
    "@openzeppelin/hardhat-upgrades": "^3.5.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.6",
    "chai": "^4.5.0",
    "dotenv": "^16.4.5",
    "erc721a": "^4.3.0",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.16",
    "hardhat-contract-sizer": "^2.10.0",
    "solidity-coverage": "^0.8.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-verify": "^2.0.12",
    "@openzeppelin/contracts": "^5.1.0"
  }
}